<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.ClipSmile" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/pikachu_yellow</item>
        <item name="colorPrimaryVariant">@color/pokemon_red</item>
        <item name="colorOnPrimary">@color/ink_on_yellow</item>
        <item name="colorSecondary">@color/pokemon_red</item>
        <item name="colorSecondaryVariant">@color/pokemon_red_dark</item>
        <item name="colorOnSecondary">@color/pikachu_yellow</item>
        <item name="android:statusBarColor">@color/night_bg</item>
        <item name="android:navigationBarColor">@color/night_bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowBackground">@color/night_bg</item>
        <item name="colorSurface">@color/night_card</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_muted</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="colorControlActivated">@color/pikachu_yellow</item>
        <item name="switchStyle">@style/Widget.ClipSmile.Switch</item>
        <item name="popupMenuStyle">@style/Widget.ClipSmile.PopupMenu</item>
        <item name="alertDialogTheme">@style/ThemeOverlay.ClipSmile.Dialog</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.ClipSmile.Dialog</item>
        <item name="snackbarStyle">@style/Widget.ClipSmile.Snackbar</item>
    </style>

    <style name="Theme.ClipSmile.Room" parent="Theme.ClipSmile">
        <item name="android:windowBackground">@color/room_bg</item>
        <item name="android:statusBarColor">@color/room_bg</item>
        <item name="android:navigationBarColor">@color/room_floor</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <style name="Theme.ClipSmile.Stage" parent="Theme.ClipSmile.Room">
        <item name="android:windowBackground">#94BDDB</item>
        <item name="android:statusBarColor">#94BDDB</item>
        <item name="android:navigationBarColor">#FFF8EC</item>
    </style>

    <style name="ShapeAppearance.ClipSmile.Circle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="PixelTitleText">
        <item name="android:fontFamily">@font/press_start_2p</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <style name="Widget.ClipSmile.PopupMenu" parent="Widget.MaterialComponents.PopupMenu">
        <item name="android:popupBackground">@color/night_raised</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="ThemeOverlay.ClipSmile.Dialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="colorSurface">@color/night_card</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorPrimary">@color/pikachu_yellow</item>
        <item name="colorOnPrimary">@color/ink_on_yellow</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:background">@color/night_card</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.ClipSmile.DialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.ClipSmile.DialogButton</item>
    </style>

    <style name="Widget.ClipSmile.DialogButton" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">@color/pikachu_yellow</item>
    </style>

    <style name="Widget.ClipSmile.Snackbar" parent="Widget.MaterialComponents.Snackbar">
        <item name="backgroundTint">@color/night_raised</item>
    </style>

    <style name="Widget.ClipSmile.Switch" parent="Widget.MaterialComponents.CompoundButton.Switch">
        <item name="thumbTint">@color/switch_thumb</item>
        <item name="trackTint">@color/switch_track</item>
    </style>
</resources>
