<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/contentRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#94BDDB"
        android:fitsSystemWindows="true"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <com.clipsmile.app.ui.PetCanvas
                android:id="@+id/petCanvas"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/pet_name_default" />

            <ImageView
                android:id="@+id/homeBed"
                android:layout_width="78dp"
                android:layout_height="58dp"
                android:layout_gravity="bottom|start"
                android:layout_marginStart="10dp"
                android:layout_marginBottom="8dp"
                android:clickable="false"
                android:contentDescription="@string/pet_name_default"
                android:focusable="false"
                android:scaleType="fitCenter" />

            <ImageView
                android:id="@+id/homeBowl"
                android:layout_width="64dp"
                android:layout_height="48dp"
                android:layout_gravity="bottom|end"
                android:layout_marginEnd="12dp"
                android:layout_marginBottom="10dp"
                android:clickable="false"
                android:contentDescription="@string/food_durum"
                android:focusable="false"
                android:scaleType="fitCenter" />

            <com.clipsmile.app.ui.FrameRingView
                android:id="@+id/frameGlow"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clickable="false"
                android:focusable="false" />

            <com.clipsmile.app.ui.BubbleLayer
                android:id="@+id/bubbles"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="invisible" />

            <com.clipsmile.app.ui.HeartBurst
                android:id="@+id/hearts"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="invisible" />

            <ImageView
                android:id="@+id/feedDoner"
                android:layout_width="78dp"
                android:layout_height="78dp"
                android:layout_gravity="bottom|end"
                android:layout_marginEnd="18dp"
                android:layout_marginBottom="92dp"
                android:contentDescription="@string/food_durum"
                android:src="@drawable/ic_doner"
                android:visibility="invisible" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingTop="8dp"
                android:paddingEnd="8dp">

                <LinearLayout
                    android:id="@+id/streakPill"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_hud_pill"
                    android:elevation="4dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="10dp"
                    android:paddingEnd="14dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:contentDescription="@string/pet_streak_label"
                        android:src="@drawable/ic_flame" />

                    <TextView
                        android:id="@+id/streakText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:textColor="#3B2918"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        tools:text="3" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/goldPill"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_hud_pill"
                    android:elevation="4dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="10dp"
                    android:paddingEnd="14dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:contentDescription="@string/store_title"
                        android:src="@drawable/ic_coin" />

                    <TextView
                        android:id="@+id/goldText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:textColor="#A67C00"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        tools:text="40" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/gemPill"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_hud_pill"
                    android:elevation="4dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="10dp"
                    android:paddingEnd="14dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:contentDescription="@string/store_gems_title"
                        android:src="@drawable/ic_gem" />

                    <TextView
                        android:id="@+id/gemText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:textColor="#6A2BD0"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        tools:text="0" />
                </LinearLayout>

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <ImageButton
                    android:id="@+id/settingsButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_hud_pill"
                    android:contentDescription="@string/action_settings"
                    android:elevation="4dp"
                    android:padding="9dp"
                    android:src="@drawable/ic_settings"
                    app:tint="#5C4632" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/namePlate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_name_plate"
                android:elevation="6dp"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="18dp"
                android:paddingTop="8dp"
                android:paddingEnd="18dp"
                android:paddingBottom="10dp">

                <LinearLayout
                    android:id="@+id/nameRow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="2dp">

                    <TextView
                        android:id="@+id/petNameText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#3B2918"
                        android:textSize="26sp"
                        android:textStyle="bold"
                        tools:text="Çirkin" />

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginStart="6dp"
                        android:contentDescription="@string/action_rename_pet"
                        android:src="@drawable/ic_edit"
                        app:tint="#5C4632" />
                </LinearLayout>

                <TextView
                    android:id="@+id/dogTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#8A6844"
                    android:textSize="13sp"
                    tools:text="Şapkalı pug" />

                <LinearLayout
                    android:id="@+id/levelRow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/levelText"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_level_badge"
                        android:gravity="center"
                        android:textColor="#3B2918"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        tools:text="1" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:orientation="vertical">

                        <ProgressBar
                            android:id="@+id/xpBar"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="132dp"
                            android:layout_height="10dp"
                            android:max="100"
                            android:progress="20"
                            android:progressDrawable="@drawable/bg_xp" />

                        <TextView
                            android:id="@+id/xpText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textColor="#2A75BB"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            tools:text="12 / 90 XP" />
                    </LinearLayout>
                </LinearLayout>

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/frameText"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_soft_button"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:stateListAnimator="@null"
                    android:text="@string/frames_title"
                    android:textAllCaps="false"
                    android:textColor="#8B5A2B"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/sectionHost"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#F6F1E8"
                android:visibility="gone" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/homeDock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_dock"
            android:elevation="12dp"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="10dp">

            <TextView
                android:id="@+id/petMoodText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="#5C4632"
                android:textSize="14sp"
                tools:text="Karnı tok." />

            <ProgressBar
                android:id="@+id/fullnessBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="10dp"
                android:layout_marginTop="8dp"
                android:max="100"
                android:progress="70"
                android:progressDrawable="@drawable/bg_fullness" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/feedButton"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_candy_orange"
                    android:maxLines="1"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:stateListAnimator="@null"
                    android:text="@string/food_durum"
                    android:textAllCaps="false"
                    android:textColor="#3B2918"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/bathButton"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_candy_blue"
                    android:maxLines="1"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:stateListAnimator="@null"
                    android:text="@string/action_bath"
                    android:textAllCaps="false"
                    android:textColor="#F7F4EF"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tabBar"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:background="#FFF8EE"
            android:elevation="18dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tabHome"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/tab_home"
                android:textColor="#1C4F80"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tabStore"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/tab_store"
                android:textColor="#8A6844"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tabTasks"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/tab_tasks"
                android:textColor="#8A6844"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tabCatalog"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/tab_catalog"
                android:textColor="#8A6844"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tabGames"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/tab_games"
                android:textColor="#8A6844"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/onboardHost"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#94BDDB"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/tutorialHost"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone" />
</FrameLayout>
