<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_room"
    android:fitsSystemWindows="true">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingTop="16dp"
            android:paddingEnd="22dp"
            android:paddingBottom="28dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="104dp"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_badge"
                    android:elevation="2dp"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp">

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_flame" />

                    <TextView
                        android:id="@+id/streakText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#3B2918"
                        android:textSize="26sp"
                        android:textStyle="bold"
                        tools:text="1" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.12"
                        android:text="@string/pet_streak_label"
                        android:textColor="#C4622D"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="104dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/bg_badge"
                    android:elevation="2dp"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp">

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_level_star" />

                    <TextView
                        android:id="@+id/levelText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#3B2918"
                        android:textSize="26sp"
                        android:textStyle="bold"
                        tools:text="1" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.12"
                        android:text="@string/pet_level_label"
                        android:textColor="#3E8C12"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <FrameLayout
                android:layout_width="260dp"
                android:layout_height="250dp"
                android:layout_marginTop="8dp">

                <View
                    android:layout_width="150dp"
                    android:layout_height="28dp"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="6dp"
                    android:background="@drawable/bg_floor_shadow" />

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/petImage"
                    android:layout_width="220dp"
                    android:layout_height="220dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/pet_name_default"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_pug_icon"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.ClipSmile.Circle"
                    app:strokeColor="#3B2918"
                    app:strokeWidth="5dp" />

                <ImageView
                    android:id="@+id/feedDoner"
                    android:layout_width="78dp"
                    android:layout_height="78dp"
                    android:layout_gravity="bottom|end"
                    android:contentDescription="@string/food_durum"
                    android:src="@drawable/ic_doner"
                    android:visibility="invisible" />
            </FrameLayout>

            <LinearLayout
                android:id="@+id/nameRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="4dp">

                <TextView
                    android:id="@+id/petNameText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#3B2918"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    tools:text="Çirkin" />

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginStart="8dp"
                    android:contentDescription="@string/action_rename_pet"
                    android:src="@drawable/ic_edit"
                    app:tint="#5C4632" />
            </LinearLayout>

            <TextView
                android:id="@+id/dogTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#8A6844"
                android:textSize="13sp"
                tools:text="Şapkalı pug" />

            <TextView
                android:id="@+id/petMoodText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:textColor="#5C4632"
                android:textSize="15sp"
                tools:text="Karnı tok." />

            <ProgressBar
                android:id="@+id/fullnessBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="200dp"
                android:layout_height="12dp"
                android:layout_marginTop="10dp"
                android:max="100"
                android:progress="70"
                android:progressDrawable="@drawable/bg_fullness" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/feedButton"
                android:layout_width="wrap_content"
                android:layout_height="54dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_candy_orange"
                android:minWidth="180dp"
                android:paddingStart="22dp"
                android:paddingEnd="22dp"
                android:stateListAnimator="@null"
                android:text="@string/food_durum"
                android:textAllCaps="false"
                android:textColor="#3B2918"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:letterSpacing="0.14"
                android:text="@string/games_label"
                android:textColor="#8A6844"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/playDrop"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_candy_green"
                        android:stateListAnimator="@null"
                        android:text="@string/game_drop"
                        android:textAllCaps="false"
                        android:textColor="#173307"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/dropBest"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="#8A6844"
                        android:textSize="12sp"
                        tools:text="En iyi 0" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/playFlappy"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_candy_green"
                        android:stateListAnimator="@null"
                        android:text="@string/game_flappy"
                        android:textAllCaps="false"
                        android:textColor="#173307"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/flappyBest"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="#8A6844"
                        android:textSize="12sp"
                        tools:text="En iyi 0" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:letterSpacing="0.14"
                android:text="@string/dogs_label"
                android:textColor="#8A6844"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/dog0"
                        android:layout_width="58dp"
                        android:layout_height="58dp"
                        android:background="@drawable/bg_slot_on"
                        android:contentDescription="@string/dog_pug_title"
                        android:padding="4dp"
                        android:src="@drawable/ic_pug_icon" />

                    <TextView
                        android:id="@+id/lock0"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:maxLines="1"
                        android:textColor="#8A6844"
                        android:textSize="11sp"
                        tools:text="1" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/dog1"
                        android:layout_width="58dp"
                        android:layout_height="58dp"
                        android:contentDescription="@string/dog_brown_title"
                        android:padding="4dp"
                        android:src="@drawable/ic_dog_brown" />

                    <TextView
                        android:id="@+id/lock1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:maxLines="1"
                        android:textColor="#8A6844"
                        android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/dog2"
                        android:layout_width="58dp"
                        android:layout_height="58dp"
                        android:contentDescription="@string/dog_spot_title"
                        android:padding="4dp"
                        android:src="@drawable/ic_dog_spot" />

                    <TextView
                        android:id="@+id/lock2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:maxLines="1"
                        android:textColor="#8A6844"
                        android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/dog3"
                        android:layout_width="58dp"
                        android:layout_height="58dp"
                        android:contentDescription="@string/dog_crown_title"
                        android:padding="4dp"
                        android:src="@drawable/ic_dog_crown" />

                    <TextView
                        android:id="@+id/lock3"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:maxLines="1"
                        android:textColor="#8A6844"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <ImageButton
        android:id="@+id/settingsButton"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="4dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/action_settings"
        android:padding="10dp"
        android:src="@drawable/ic_settings"
        app:tint="#5C4632" />

</FrameLayout>
